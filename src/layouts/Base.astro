---
import Marble from '../components/Marble.astro';
import '../styles/global.css';

const {
  title = 'kennytherex',
  description = 'Kenneth Solomon, cybersecurity, programming, and thoughts.',
  showProgress = false,
  image = '/images/banner.jpg',
} = Astro.props;

const path = Astro.url.pathname;

const links = [
  { href: '/journal', label: 'Journal', icon: '<path d="M4 5.5C4 4.7 4.7 4 5.5 4H11v16H5.5C4.7 20 4 19.3 4 18.5V5.5Z"/><path d="M20 5.5C20 4.7 19.3 4 18.5 4H13v16h5.5c.8 0 1.5-.7 1.5-1.5V5.5Z"/>' },
  { href: '/cybersecurity', label: 'Cybersecurity', icon: '<path d="M12 3l7 3v5c0 5-3.4 8.7-7 10-3.6-1.3-7-5-7-10V6l7-3Z"/><path d="M9.5 12l2 2 3.5-3.5"/>' },
  { href: '/programming', label: 'Programming', icon: '<polyline points="9 6 3 12 9 18"/><polyline points="15 6 21 12 15 18"/>' },
  { href: '/notes', label: 'Notes', icon: '<rect x="5" y="3" width="14" height="18" rx="2"/><line x1="8" y1="8" x2="16" y2="8"/><line x1="8" y1="12" x2="16" y2="12"/><line x1="8" y1="16" x2="12" y2="16"/>' },
  { href: '/about', label: 'About', icon: '<circle cx="12" cy="8" r="3.5"/><path d="M5 20c0-3.9 3.1-7 7-7s7 3.1 7 7"/>' },
];

const ogImage = new URL(image, Astro.site ?? Astro.url.origin).href;

const socials = {
  github: 'https://github.com/syndromelinen',
  linkedin: 'https://www.linkedin.com/in/kenneth-solomon-15000a381/',
  hackthebox: 'https://profile.hackthebox.com/profile/019cb26f-3741-71a0-9919-68e0ae09240d',
  x: 'https://x.com/Kennytherex_',
};

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Kenneth Solomon',
  alternateName: 'kennytherex',
  url: (Astro.site ?? Astro.url.origin).toString(),
  sameAs: [socials.github, socials.linkedin, socials.hackthebox, socials.x],
  jobTitle: 'Cybersecurity practitioner',
  description: 'Cybersecurity, programming, and journal writing.',
};
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <meta name="robots" content="index, follow" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=Inter:wght@400;500&family=JetBrains+Mono:ital,wght@0,400;0,500;0,700;1,400&display=swap"
  />

  <meta property="og:title" content={`${title} · kennytherex`} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={Astro.url.href} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:site_name" content="kennytherex" />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={`${title} · kennytherex`} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <title>{title} · kennytherex</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="alternate" type="application/rss+xml" title="kennytherex" href="/rss.xml" />
  <link rel="canonical" href={Astro.url.href} />

  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <script is:inline>
    // runs before paint — avoids a flash of the wrong theme
    (function () {
      const saved = localStorage.getItem('theme');
      const theme = saved || 'dark';
      if (theme === 'terminal') document.documentElement.setAttribute('data-theme', 'terminal');
    })();
  </script>
</head>
<body>
  {showProgress && <div id="reading-progress"></div>}

  <div id="crt-overlay" aria-hidden="true"></div>
  <div id="boot-log" aria-hidden="true"></div>

  <Marble />

  <nav class="navbar" id="navbar">
    <div class="navbar-inner">
      <a href="/" class="navbar-logo">kenny<span>therex</span></a>

      <div class="navbar-actions">
        <a href="/search" class="navbar-icon-btn" aria-current={path === '/search' ? 'page' : undefined} aria-label="Search">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display:block;">
            <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
          </svg>
        </a>
        <button id="theme-toggle" class="navbar-icon-btn" aria-label="Toggle theme">
          <svg class="icon-sun" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="3" y="4" width="18" height="16" rx="2"/>
            <line x1="3" y1="9" x2="21" y2="9"/>
            <line x1="7" y1="6.5" x2="7" y2="6.5"/>
            <line x1="10.5" y1="6.5" x2="10.5" y2="6.5"/>
          </svg>
          <svg class="icon-moon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="4 6 10 12 4 18"/>
            <line x1="12" y1="18" x2="20" y2="18"/>
          </svg>
        </button>
        <button id="nav-grid-toggle" class="navbar-icon-btn" aria-label="Open navigation" aria-expanded="false" aria-controls="nav-grid-panel">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
            <circle cx="5" cy="5" r="1.7"/><circle cx="12" cy="5" r="1.7"/><circle cx="19" cy="5" r="1.7"/>
            <circle cx="5" cy="12" r="1.7"/><circle cx="12" cy="12" r="1.7"/><circle cx="19" cy="12" r="1.7"/>
            <circle cx="5" cy="19" r="1.7"/><circle cx="12" cy="19" r="1.7"/><circle cx="19" cy="19" r="1.7"/>
          </svg>
        </button>
      </div>

      <div class="nav-grid-panel" id="nav-grid-panel" role="menu">
        <div class="nav-grid">
          {links.map(l => (
            <a
              href={l.href}
              class="nav-grid-item"
              role="menuitem"
              aria-current={path.startsWith(l.href) ? 'page' : undefined}
            >
              <span class="nav-grid-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={l.icon} />
              </span>
              <span class="nav-grid-label">{l.label}</span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </nav>

  <div class="site page-enter">
    <main>
      <slot />
    </main>

    <footer>
      <div class="footer-top">
        <div class="footer-brand">
          <a href="/" class="footer-logo">kenny<span>therex</span></a>
          <p class="footer-tagline">
            Writing about cybersecurity, programming<br />
            and the journey.
          </p>
        </div>
        <div class="footer-links">
          <a href={socials.github} target="_blank" rel="noopener">GitHub</a>
          <a href={socials.linkedin} target="_blank" rel="noopener">LinkedIn</a>
          <a href={socials.hackthebox} target="_blank" rel="noopener">HackTheBox</a>
          <a href={socials.x} target="_blank" rel="noopener">X</a>
        </div>
      </div>
    </footer>
  </div>

  <button id="scroll-top" aria-label="Scroll to top" onclick="window.scrollTo({top:0,behavior:'smooth'})">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <polyline points="18 15 12 9 6 15"/>
    </svg>
  </button>

  <script>
    import { animate, inView, stagger } from 'motion';

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const ease = [0.22, 1, 0.36, 1];

    // Cmd/Ctrl+K — jump to search, or focus it if already on a search-enabled page
    document.addEventListener('keydown', (e) => {
      const isK = e.key === 'k' || e.key === 'K';
      if ((e.metaKey || e.ctrlKey) && isK) {
        e.preventDefault();
        const input = document.getElementById('search');
        if (input) {
          input.focus();
        } else {
          window.location.href = '/search';
        }
      }
    });

    // Theme toggle — CRT collapse → boot log (entering terminal) → expand
    const themeBtn = document.getElementById('theme-toggle');
    const crtOverlay = document.getElementById('crt-overlay');
    const bootLog = document.getElementById('boot-log');
    const bootLines = ['initializing kernel...', 'loading modules...', 'mounting /dev/terminal...', '[ OK ]'];
    let themeBusy = false;

    themeBtn?.addEventListener('click', () => {
      if (themeBusy) return;
      const goingTerminal = document.documentElement.getAttribute('data-theme') !== 'terminal';

      if (reduceMotion || !crtOverlay || !bootLog) {
        applyTheme(goingTerminal);
        document.dispatchEvent(new CustomEvent('themechange', { detail: { theme: goingTerminal ? 'terminal' : 'dark' } }));
        return;
      }

      themeBusy = true;
      bootLog.innerHTML = '';
      bootLog.classList.remove('visible');
      crtOverlay.classList.remove('crt-expand');
      // force reflow so the animation restarts cleanly on repeated clicks
      void crtOverlay.offsetWidth;
      crtOverlay.classList.add('crt-collapse');

      const collapseMs = 220;
      const lineDelay = 300;
      const readPauseMs = 500;
      const holdMs = goingTerminal ? bootLines.length * lineDelay + readPauseMs : 180;
      const expandMs = 220;

      setTimeout(() => {
        applyTheme(goingTerminal);
        document.dispatchEvent(new CustomEvent('themechange', { detail: { theme: goingTerminal ? 'terminal' : 'dark' } }));

        if (goingTerminal) {
          bootLog.classList.add('visible');
          bootLines.forEach((line, i) => {
            setTimeout(() => {
              const row = document.createElement('div');
              row.className = 'boot-line';
              row.textContent = line;
              bootLog.appendChild(row);
              requestAnimationFrame(() => row.classList.add('in'));
            }, i * lineDelay);
          });
        }

        setTimeout(() => {
          crtOverlay.classList.remove('crt-collapse');
          crtOverlay.classList.add('crt-expand');
          bootLog.classList.remove('visible');
          setTimeout(() => {
            crtOverlay.classList.remove('crt-expand');
            bootLog.innerHTML = '';
            themeBusy = false;
          }, expandMs);
        }, holdMs);
      }, collapseMs);
    });

    function applyTheme(goingTerminal: boolean) {
      if (goingTerminal) {
        document.documentElement.setAttribute('data-theme', 'terminal');
        localStorage.setItem('theme', 'terminal');
      } else {
        document.documentElement.removeAttribute('data-theme');
        localStorage.setItem('theme', 'dark');
      }
    }

    // Navbar scroll effect
    const navbar = document.getElementById('navbar');
    window.addEventListener('scroll', () => {
      navbar?.classList.toggle('scrolled', window.scrollY > 40);
    }, { passive: true });

    // Scroll to top visibility
    const scrollBtn = document.getElementById('scroll-top');
    window.addEventListener('scroll', () => {
      scrollBtn?.classList.toggle('visible', window.scrollY > 500);
    }, { passive: true });

    // Reading progress
    const bar = document.getElementById('reading-progress');
    if (bar) {
      window.addEventListener('scroll', () => {
        const doc = document.documentElement;
        const pct = (doc.scrollTop / (doc.scrollHeight - doc.clientHeight)) * 100;
        bar.style.width = pct + '%';
      }, { passive: true });
    }

    // Scroll reveal — Motion One, staggered, respects reduced-motion
    const revealEls = Array.from(document.querySelectorAll('.reveal-up'));
    if (reduceMotion) {
      revealEls.forEach(el => el.classList.add('in-view'));
    } else {
      let pending = [];
      let flushTimer = null;
      inView(revealEls, (el) => {
        // skip elements a page's own script already marked visible
        // (e.g. instantly-rendered search/filter results)
        if (el.classList.contains('in-view')) return;
        pending.push(el);
        clearTimeout(flushTimer);
        flushTimer = setTimeout(() => {
          const batch = pending.splice(0);
          animate(
            batch,
            { opacity: [0, 1], y: [24, 0] },
            { duration: 0.6, delay: stagger(0.06), easing: ease }
          );
          batch.forEach(el => el.classList.add('in-view'));
        }, 16);
      }, { margin: '0px 0px -80px 0px' });
    }

    // Nav grid dropdown
    const gridBtn = document.getElementById('nav-grid-toggle');
    const gridPanel = document.getElementById('nav-grid-panel');
    let gridOpen = false;

    function closeGrid() {
      if (!gridOpen) return;
      gridOpen = false;
      gridBtn?.setAttribute('aria-expanded', 'false');
      gridPanel?.classList.remove('open');
    }

    function openGrid() {
      gridOpen = true;
      gridBtn?.setAttribute('aria-expanded', 'true');
      gridPanel?.classList.add('open');
    }

    gridBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      gridOpen ? closeGrid() : openGrid();
    });
    gridPanel?.querySelectorAll('a').forEach(a => a.addEventListener('click', () => closeGrid()));
    document.addEventListener('click', (e) => {
      if (gridOpen && gridPanel && !gridPanel.contains(e.target as Node) && e.target !== gridBtn) closeGrid();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeGrid();
    });

    // Share button (on post pages) — native share sheet, falls back to copy link
    const shareBtn = document.getElementById('share-btn');
    shareBtn?.addEventListener('click', async () => {
      const shareData = {
        title: shareBtn.dataset.title || document.title,
        url: window.location.href,
      };
      const label = shareBtn.querySelector('.share-btn-label');
      try {
        if (navigator.share) {
          await navigator.share(shareData);
        } else {
          await navigator.clipboard.writeText(shareData.url);
          if (label) {
            const original = label.textContent;
            label.textContent = 'Copied!';
            shareBtn.classList.add('copied');
            setTimeout(() => {
              label.textContent = original;
              shareBtn.classList.remove('copied');
            }, 2000);
          }
        }
      } catch (err) {
        // user dismissed the native share sheet — no-op
      }
    });

    // Copy code buttons
    document.querySelectorAll('pre').forEach(pre => {
      const btn = document.createElement('button');
      btn.className = 'copy-btn';
      btn.textContent = 'copy';
      btn.addEventListener('click', () => {
        navigator.clipboard.writeText(pre.querySelector('code')?.textContent || '');
        btn.textContent = 'copied!';
        btn.classList.add('copied');
        setTimeout(() => { btn.textContent = 'copy'; btn.classList.remove('copied'); }, 2000);
      });
      pre.style.position = 'relative';
      pre.appendChild(btn);
    });
  </script>
</body>
</html>
