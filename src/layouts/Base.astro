---
import Marble from '../components/Marble.astro';
import '../styles/global.css';

const { title = 'kennytherex', description = "Kenneth Solomon — cybersec, offensive security, the grind." } = Astro.props;
const currentPath = Astro.url.pathname;

const navLinks = [
  { href: '/', label: 'home' },
  { href: '/blog', label: 'blog' },
  { href: '/notes', label: 'notes' },
  { href: '/about', label: 'about' },
];
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <title>{title} · kennytherex</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="alternate" type="application/rss+xml" title="kennytherex" href="/rss.xml" />
</head>
<body>
  <Marble />

  <div class="site-wrap">
    <nav>
      <a href="/" class="nav-logo">~/<span>kennytherex</span></a>
      <ul class="nav-links">
        {navLinks.map(link => (
          <li>
            <a
              href={link.href}
              aria-current={currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href)) ? 'page' : undefined}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <main>
      <slot />
    </main>

    <footer>
      <span class="footer-left">© {new Date().getFullYear()} kenneth solomon</span>
      <div class="footer-links">
        <a href="https://github.com/syndromelinen" target="_blank" rel="noopener">github</a>
        <a href="https://app.hackthebox.com/profile/2522807" target="_blank" rel="noopener">htb</a>
        <a href="/rss.xml">rss</a>
      </div>
    </footer>
  </div>
</body>
</html>
