---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { readingTimeMinutes } from '../utils/readingTime';

const posts = await getCollection('cybersecurity', p => !p.data.draft);
const sorted = posts.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

const allTags = [...new Set(sorted.flatMap(p => p.data.tags))];
const postsJSON = JSON.stringify(sorted.map(p => ({
  slug: p.slug,
  title: p.data.title,
  description: p.data.description,
  date: p.data.date,
  tags: p.data.tags,
  readingTime: readingTimeMinutes(p.body),
})));

function fmt(d: string) {
  return new Date(d).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
}
---

<Base title="cybersecurity">
  <div style="padding-top: 88px;">
    <div class="section-title" style="margin-bottom: 8px;">Cybersecurity</div>
    <h1 style="font-family: var(--font-head); font-size: 32px; font-weight: 700; letter-spacing: -0.02em; margin-bottom: 10px;">
      Breaking things.
    </h1>
    <p style="color: var(--muted); margin-bottom: 40px; max-width: 440px;">
      CTFs, cert notes, machine writeups, and everything offensive security.
    </p>

    <div class="search-wrap">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
      </svg>
      <input id="search" class="search-input" type="search" placeholder="Search posts..." autocomplete="off" />
    </div>

    <div class="tags-row" id="tags">
      <button class="tag-btn active" data-tag="all">all</button>
      {allTags.map(t => <button class="tag-btn" data-tag={t}>{t}</button>)}
    </div>

    <div class="cards-grid" id="posts"></div>
    <div class="empty-state" id="empty" style="display:none;">Nothing found.</div>
  </div>
</Base>

<script define:vars={{ postsJSON }}>
  const POSTS = JSON.parse(postsJSON);
  let activeTag = 'all', query = '';

  function fmt(d) {
    return new Date(d).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
  }

  function render() {
    const el = document.getElementById('posts');
    const empty = document.getElementById('empty');
    const q = query.toLowerCase();
    const filtered = POSTS.filter(p => {
      const tm = activeTag === 'all' || p.tags.includes(activeTag);
      const sm = !q || p.title.toLowerCase().includes(q) || p.description.toLowerCase().includes(q);
      return tm && sm;
    });
    empty.style.display = filtered.length ? 'none' : 'block';
    el.innerHTML = filtered.map((p, i) => `
      <a href="/cybersecurity/${p.slug}" class="blog-card reveal-up" style="transition-delay:${i*0.05}s">
        <div class="card-meta">
          <span class="card-date">${fmt(p.date)}</span>
          <span class="card-dot">·</span>
          <span class="card-reading">${p.readingTime} min read</span>
        </div>
        <div class="card-title">${p.title}</div>
        <div class="card-desc">${p.description}</div>
        <div class="card-footer">
          <div class="card-tags">${p.tags.slice(0,3).map(t => `<span class="tag">${t}</span>`).join('')}</div>
          <span class="card-read">Read <span class="btn-arrow">→</span></span>
        </div>
      </a>
    `).join('');
    requestAnimationFrame(() => {
      document.querySelectorAll('.reveal-up:not(.in-view)').forEach(el => el.classList.add('in-view'));
    });
  }

  document.getElementById('search').addEventListener('input', e => { query = e.target.value; render(); });
  document.getElementById('tags').addEventListener('click', e => {
    const btn = e.target.closest('.tag-btn');
    if (!btn) return;
    document.querySelectorAll('.tag-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    activeTag = btn.dataset.tag;
    render();
  });

  render();
</script>
