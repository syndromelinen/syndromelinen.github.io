---
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import avatar from '../assets/avatar.jpg';
---

<Base title="about">
  <div style="padding-top: 88px;">
    <div class="section-title" style="margin-bottom: 8px;">About</div>

    <Image
      src={avatar}
      alt="Kenneth Solomon"
      width={88}
      height={88}
      loading="eager"
      class="about-avatar"
    />

    <div class="about-text" style="margin-top: 32px;">
      <p>Hi.</p>
      <p>
        I'm <strong>Kenneth</strong>, <strong>kennytherex</strong> online.
        I study cybersecurity, build things, and write about what I learn.
      </p>
      <p>
        Outside of security, I care about <strong>mathematics and physics</strong>, not as study material,
        but as genuine interests. There's a loose dream of understanding aerospace someday.
      </p>
      <p>
        <strong>Faith</strong> is the anchor. Everything else is built on top of that.
      </p>
      <p>
        This site is where I keep the grind, the machines, the small wins, the rough patches.
        If you're on a similar path, hello.
      </p>
    </div>

    <div class="contact-section reveal-up">
      <div class="section-title" style="margin-bottom: 20px;">Contact</div>

      <a href="mailto:kennethsolomon.975@gmail.com" class="contact-email-card">
        <div class="contact-email-left">
          <span class="contact-email-icon">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/>
            </svg>
          </span>
          <div class="contact-email-text">
            <div class="contact-email-label">Email</div>
            <div class="contact-email-value">kennethsolomon.975@gmail.com</div>
          </div>
        </div>
        <span class="contact-email-arrow">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="7" y1="17" x2="17" y2="7"/><polyline points="7 7 17 7 17 17"/>
          </svg>
        </span>
      </a>

      <div class="contact-socials">
        <a href="https://github.com/syndromelinen" target="_blank" rel="noopener" class="contact-social-btn">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 .5C5.65.5.5 5.65.5 12a11.5 11.5 0 0 0 7.86 10.93c.58.1.79-.25.79-.56v-2.17c-3.2.7-3.87-1.36-3.87-1.36-.53-1.33-1.29-1.69-1.29-1.69-1.05-.72.08-.7.08-.7 1.17.08 1.78 1.2 1.78 1.2 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.09-.12-.29-.51-1.46.11-3.04 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.8 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.58.24 2.75.12 3.04.74.8 1.19 1.83 1.19 3.09 0 4.42-2.7 5.4-5.26 5.68.42.36.78 1.07.78 2.16v3.2c0 .31.21.67.8.56A11.5 11.5 0 0 0 23.5 12c0-6.35-5.15-11.5-11.5-11.5Z"/>
          </svg>
          GitHub
        </a>
        <a href="https://www.linkedin.com/in/kenneth-solomon-15000a381/" target="_blank" rel="noopener" class="contact-social-btn">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor">
            <path d="M20.45 20.45h-3.55v-5.57c0-1.33-.02-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.36V9h3.41v1.56h.05c.47-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29ZM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12ZM7.12 20.45H3.56V9h3.56v11.45Z"/>
          </svg>
          LinkedIn
        </a>
        <a href="https://profile.hackthebox.com/profile/019cb26f-3741-71a0-9919-68e0ae09240d" target="_blank" rel="noopener" class="contact-social-btn">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 2 3 7v10l9 5 9-5V7l-9-5Z"/><path d="M3 7l9 5 9-5"/><path d="M12 22V12"/>
          </svg>
          HackTheBox
        </a>
        <a href="https://x.com/Kennytherex_" target="_blank" rel="noopener" class="contact-social-btn">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
            <path d="M18.24 2.25h3.31l-7.23 8.26 8.5 11.24h-6.66l-5.22-6.82-5.97 6.82H1.65l7.73-8.84L1.2 2.25h6.83l4.72 6.24 5.49-6.24Zm-1.16 17.52h1.83L7.02 4.13H5.06l12.02 15.64Z"/>
          </svg>
          X
        </a>
      </div>
    </div>
  </div>
</Base>
