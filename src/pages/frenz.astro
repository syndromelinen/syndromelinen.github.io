---
import Base from '../layouts/Base.astro';

const frenz = [
  {
    name: 'The Darknet Community',
    tagline: '4,000+ member cybersecurity community across Mumbai & Nagpur. Workshops, mentorship, CTFs — no gatekeeping. I\'m HR lead here.',
    url: 'https://www.thedarknetcommunity.com/',
    domain: 'thedarknetcommunity.com',
    color: '#8b5cf6',
  },
  {
    name: 'Yash',
    tagline: 'Cybersecurity and comfy tech posts by Yash — runs the Cozy Fren Terminal blog.',
    url: 'https://yashfren.net/',
    domain: 'yashfren.net',
    color: '#4ade80',
  },
];
---

<Base title="frenz">
  <div style="padding-top: 88px;">
    <div class="section-title" style="margin-bottom: 8px;">Frenz / Associates</div>

    <div class="about-text" style="margin-top: 12px; margin-bottom: 32px;">
      <p>People and communities on a similar path.</p>
    </div>

    <div class="cards-grid">
      {frenz.map((f) => (
        <a href={f.url} target="_blank" rel="noopener noreferrer" class="blog-card" style={`border-left: 3px solid ${f.color}`}>
          <div class="card-title-row">
            <img
              class="card-favicon"
              src={`https://www.google.com/s2/favicons?sz=64&domain=${f.domain}`}
              alt=""
              width="20"
              height="20"
              loading="lazy"
              onerror="this.style.display='none'"
            />
            <div class="card-title">{f.name}</div>
          </div>
          <div class="card-desc">{f.tagline}</div>
          <div class="card-footer">
            <span class="card-date">{f.domain}</span>
            <span class="card-read">
              Visit
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="7" y1="17" x2="17" y2="7"/><polyline points="7 7 17 7 17 17"/>
              </svg>
            </span>
          </div>
        </a>
      ))}
    </div>

    <div class="contact-section reveal-up" style="margin-top: 48px;">
      <div class="section-title" style="margin-bottom: 8px;">🤝 Wanna be frenz?</div>

      <div class="about-text" style="margin-top: 12px; margin-bottom: 20px;">
        <p>It's simple! Add my site to your blog using the config below, then hit me up on GitHub, X, or email so I can add you back.</p>
      </div>

      <pre class="frenz-pre"><code>{`name: Kenneth Solomon
site: kennytherex
url: https://kennytherex.dev
description: Cybersecurity, programming, and journal writing.
avatar: https://kennytherex.dev/favicon-48x48.png
color: #8b0000`}</code></pre>

      <div class="contact-socials" style="margin-top: 20px;">
        <a href="https://github.com/syndromelinen" target="_blank" rel="noopener" class="contact-social-btn">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 .5C5.65.5.5 5.65.5 12a11.5 11.5 0 0 0 7.86 10.93c.58.1.79-.25.79-.56v-2.17c-3.2.7-3.87-1.36-3.87-1.36-.53-1.33-1.29-1.69-1.29-1.69-1.05-.72.08-.7.08-.7 1.17.08 1.78 1.2 1.78 1.2 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.09-.12-.29-.51-1.46.11-3.04 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.8 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.58.24 2.75.12 3.04.74.8 1.19 1.83 1.19 3.09 0 4.42-2.7 5.4-5.26 5.68.42.36.78 1.07.78 2.16v3.2c0 .31.21.67.8.56A11.5 11.5 0 0 0 23.5 12c0-6.35-5.15-11.5-11.5-11.5Z"/>
          </svg>
          GitHub
        </a>
        <a href="https://x.com/Kennytherex_" target="_blank" rel="noopener" class="contact-social-btn">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
            <path d="M18.24 2.25h3.31l-7.23 8.26 8.5 11.24h-6.66l-5.22-6.82-5.97 6.82H1.65l7.73-8.84L1.2 2.25h6.83l4.72 6.24 5.49-6.24Zm-1.16 17.52h1.83L7.02 4.13H5.06l12.02 15.64Z"/>
          </svg>
          X
        </a>
        <a href="mailto:kennethsolomon.975@gmail.com" class="contact-social-btn">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/>
          </svg>
          Email
        </a>
      </div>
    </div>
  </div>
</Base>