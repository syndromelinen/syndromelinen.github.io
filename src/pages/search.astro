---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const cyber = await getCollection('cybersecurity', p => !p.data.draft);
const prog = await getCollection('programming', p => !p.data.draft);
const journal = await getCollection('journal', p => !p.data.draft);
const notes = await getCollection('notes', p => !p.data.draft);
const maths = await getCollection('maths', p => !p.data.draft);
const random = await getCollection('random', p => !p.data.draft);

const all = [
  ...cyber.map(p => ({ slug: p.slug, section: 'cybersecurity', ...p.data, tags: p.data.tags ?? [] })),
  ...prog.map(p => ({ slug: p.slug, section: 'programming', ...p.data, tags: p.data.tags ?? [] })),
  ...journal.map(p => ({ slug: p.slug, section: 'journal', ...p.data, tags: [] })),
  ...notes.map(p => ({ slug: p.slug, section: 'notes', ...p.data, tags: p.data.tags ?? [] })),
  ...maths.map(p => ({ slug: p.slug, section: 'maths', ...p.data, tags: p.data.tags ?? [] })),
  ...random.map(p => ({ slug: p.slug, section: 'random', ...p.data, tags: p.data.tags ?? [] })),
].sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());

const postsJSON = JSON.stringify(all);
---

<Base title="search" description="Search across journal, cybersecurity, programming, notes, maths, and random.">
  <div style="padding-top: 88px;">
    <div class="section-title" style="margin-bottom: 8px;">Search</div>
    <h1 style="font-family: var(--font-head); font-size: 32px; font-weight: 700; letter-spacing: -0.02em; margin-bottom: 10px;">
      Find anything.
    </h1>
    <p style="color: var(--muted); margin-bottom: 40px; max-width: 440px;">
      Search across journal, cybersecurity, programming, notes, maths, and random at once.
    </p>

    <div class="search-wrap">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
      </svg>
      <input id="search" class="search-input" type="search" placeholder="Search all posts..." autocomplete="off" autofocus />
    </div>

    <div class="tags-row" id="sections">
      <button class="tag-btn active" data-section="all">all</button>
      <button class="tag-btn" data-section="journal">journal</button>
      <button class="tag-btn" data-section="cybersecurity">cybersecurity</button>
      <button class="tag-btn" data-section="programming">programming</button>
      <button class="tag-btn" data-section="notes">notes</button>
      <button class="tag-btn" data-section="maths">maths</button>
      <button class="tag-btn" data-section="random">random</button>
    </div>

    <div class="cards-grid" id="posts"></div>
    <div class="empty-state" id="empty" style="display:none;">Nothing found.</div>
  </div>
</Base>

<script define:vars={{ postsJSON }}>
  const POSTS = JSON.parse(postsJSON);
  let activeSection = 'all', query = '';

  function fmt(d) {
    return new Date(d).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
  }

  function render() {
    const el = document.getElementById('posts');
    const empty = document.getElementById('empty');
    const q = query.toLowerCase();
    const filtered = POSTS.filter(p => {
      const sectionMatch = activeSection === 'all' || p.section === activeSection;
      const queryMatch = !q
        || p.title.toLowerCase().includes(q)
        || p.description.toLowerCase().includes(q)
        || (p.tags || []).some(t => t.toLowerCase().includes(q));
      return sectionMatch && queryMatch;
    });
    empty.style.display = filtered.length ? 'none' : 'block';
    el.innerHTML = filtered.map((p, i) => `
      <a href="/${p.section}/${p.slug}" class="blog-card reveal-up" style="transition-delay:${i*0.05}s">
        <div class="card-meta">
          <span class="card-date">${fmt(p.date)}</span>
          <span class="card-dot">·</span>
          <span class="card-date">${p.section}</span>
        </div>
        <div class="card-title">${p.title}</div>
        <div class="card-desc">${p.description}</div>
        <div class="card-footer">
          <div class="card-tags">${(p.tags || []).slice(0,3).map(t => `<span class="tag">${t}</span>`).join('')}</div>
          <span class="card-read">Read <span class="btn-arrow">→</span></span>
        </div>
      </a>
    `).join('');
    requestAnimationFrame(() => {
      document.querySelectorAll('.reveal-up:not(.in-view)').forEach(el => el.classList.add('in-view'));
    });
  }

  document.getElementById('search').addEventListener('input', e => { query = e.target.value; render(); });
  document.getElementById('sections').addEventListener('click', e => {
    const btn = e.target.closest('.tag-btn');
    if (!btn) return;
    document.querySelectorAll('#sections .tag-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    activeSection = btn.dataset.section;
    render();
  });

  render();
</script>
