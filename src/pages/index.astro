---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import avatar from '../assets/avatar.jpg';

const cyber = await getCollection('cybersecurity', p => !p.data.draft);
const prog = await getCollection('programming', p => !p.data.draft);
const journal = await getCollection('journal', p => !p.data.draft);
const notes = await getCollection('notes', p => !p.data.draft);
const maths = await getCollection('maths', p => !p.data.draft);
const random = await getCollection('random', p => !p.data.draft);

function fmt(d: string) {
  return new Date(d).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
}

function postLabel(n: number) {
  return `${n} ${n === 1 ? 'post' : 'posts'}`;
}

const recentPosts = [
  ...journal.map(p => ({ slug: p.slug, section: 'journal', date: p.data.date, title: p.data.title, description: p.data.description })),
  ...cyber.map(p => ({ slug: p.slug, section: 'cybersecurity', date: p.data.date, title: p.data.title, description: p.data.description })),
  ...prog.map(p => ({ slug: p.slug, section: 'programming', date: p.data.date, title: p.data.title, description: p.data.description })),
  ...notes.map(p => ({ slug: p.slug, section: 'notes', date: p.data.date, title: p.data.title, description: p.data.description })),
  ...maths.map(p => ({ slug: p.slug, section: 'maths', date: p.data.date, title: p.data.title, description: p.data.description })),
  ...random.map(p => ({ slug: p.slug, section: 'random', date: p.data.date, title: p.data.title, description: p.data.description })),
]
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime())
  .slice(0, 6);

const categories = [
  {
    href: '/journal', label: 'Journal', count: journal.length,
    description: 'Weekly logs, personal notes, and everything in between.',
    bg: 'radial-gradient(120% 90% at 15% 0%, rgba(214,214,210,0.18), transparent 55%)',
    icon: '<path d="M4 5.5C4 4.7 4.7 4 5.5 4H11v16H5.5C4.7 20 4 19.3 4 18.5V5.5Z"/><path d="M20 5.5C20 4.7 19.3 4 18.5 4H13v16h5.5c.8 0 1.5-.7 1.5-1.5V5.5Z"/>',
  },
  {
    href: '/cybersecurity', label: 'Cybersecurity', count: cyber.length,
    description: 'CTFs, cert notes, and offensive security writeups.',
    bg: 'radial-gradient(120% 90% at 85% 100%, rgba(214,214,210,0.2), transparent 55%)',
    icon: '<path d="M12 3l7 3v5c0 5-3.4 8.7-7 10-3.6-1.3-7-5-7-10V6l7-3Z"/><path d="M9.5 12l2 2 3.5-3.5"/>',
  },
  {
    href: '/programming', label: 'Programming', count: prog.length,
    description: 'Code, tools, and scripts I\'m building or learning.',
    bg: 'radial-gradient(120% 90% at 50% 0%, rgba(214,214,210,0.16), transparent 60%)',
    icon: '<polyline points="9 6 3 12 9 18"/><polyline points="15 6 21 12 15 18"/>',
  },
  {
    href: '/notes', label: 'Notes', count: notes.length,
    description: 'Cheatsheets and things worth remembering.',
    bg: 'radial-gradient(120% 90% at 10% 100%, rgba(214,214,210,0.17), transparent 55%)',
    icon: '<rect x="5" y="3" width="14" height="18" rx="2"/><line x1="8" y1="8" x2="16" y2="8"/><line x1="8" y1="12" x2="16" y2="12"/><line x1="8" y1="16" x2="12" y2="16"/>',
  },
  {
    href: '/maths', label: 'Maths', count: maths.length,
    description: 'Problems, proofs, and genuine interest — not homework.',
    bg: 'radial-gradient(120% 90% at 90% 0%, rgba(214,214,210,0.19), transparent 55%)',
    icon: '<path d="M6 5h12l-6.5 7L18 19H6"/>',
  },
  {
    href: '/random', label: 'Random', count: random.length,
    description: 'Stray thoughts, side quests, and small experiments.',
    bg: 'radial-gradient(120% 90% at 50% 100%, rgba(214,214,210,0.18), transparent 60%)',
    icon: '<polyline points="16 3 21 3 21 8"/><line x1="4" y1="20" x2="21" y2="3"/><polyline points="21 16 21 21 16 21"/><line x1="15" y1="15" x2="21" y2="21"/><line x1="4" y1="4" x2="9" y2="9"/>',
  },
];
---

<Base title="home">

  <!-- HERO -->
  <section class="hero">
    <div class="hero-glow"></div>
    <h1>kennytherex<span class="dot">.</span></h1>
    <div class="hero-stack">
      <span>Cybersecurity.</span> Programming. <span class="thoughts-word">Thoughts.</span>
    </div>
    <p class="hero-desc">
      Just a cybersec guy — mostly offensive security.
    </p>
    <div class="hero-btns">
      <a href="/journal" class="btn btn-primary">
        Read Journal <span class="btn-arrow">→</span>
      </a>
      <a href="/cybersecurity" class="btn btn-secondary">Browse Writeups</a>
    </div>

    <button class="scroll-cue" aria-label="Scroll to content" onclick="document.getElementById('about-preview').scrollIntoView({behavior:'smooth'})">
      <span class="scroll-cue-line"></span>
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <polyline points="6 9 12 15 18 9"/>
      </svg>
    </button>
  </section>

  <!-- ABOUT PREVIEW -->
  <section class="about-preview reveal-up" id="about-preview">
    <Image src={avatar} alt="Kenneth Solomon" width={64} height={64} loading="eager" class="about-preview-avatar" />
    <div class="about-preview-text">
      <p>
        I'm <strong>Kenneth</strong>, <strong>kennytherex</strong> online — I study cybersecurity,
        build things, and write about what I learn.
      </p>
      <a href="/about" class="view-all">More about me →</a>
    </div>
  </section>

  <hr class="divider" />

  <!-- CATEGORIES -->
  <section class="section-block reveal-up">
    <div class="section-header">
      <span class="section-title">Categories</span>
    </div>
    <div class="category-grid" id="category-grid">
      {categories.map(c => (
        <a href={c.href} class="category-card reveal-up" style={`--cat-bg:${c.bg}`}>
          <span class="category-card-bg"></span>
          <span class="category-card-content">
            <span class="category-icon">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={c.icon} />
            </span>
            <span class="category-text">
              <span class="category-name">{c.label}</span>
              <span class="category-desc">{c.description}</span>
            </span>
            <span class="category-count-pill">{postLabel(c.count)}</span>
          </span>
        </a>
      ))}
    </div>
  </section>

  <hr class="divider" />

  <!-- RECENT POSTS -->
  <section class="section-block reveal-up">
    <div class="section-header">
      <span class="section-title">Recent Posts</span>
      <a href="/search" class="view-all">View all →</a>
    </div>
    <div class="recent-stack">
      {recentPosts.map((post, i) => (
        <a href={`/${post.section}/${post.slug}`} class="recent-card reveal-up" style={`--i:${i}`}>
          <span class="recent-node">
            <span class="recent-node-dot"></span>
          </span>
          <span class="recent-card-body">
            <span class="recent-card-meta">
              <span class="recent-card-section">{post.section}</span>
              <span class="card-dot">·</span>
              <span class="card-date">{fmt(post.date)}</span>
            </span>
            <span class="card-title">{post.title}</span>
            <span class="card-desc">{post.description}</span>
          </span>
        </a>
      ))}
    </div>
  </section>

  <script>
    const heading = document.querySelector<HTMLElement>('.hero h1');
    const fullHTML = heading?.innerHTML ?? '';
    const fullText = heading?.textContent ?? '';
    let typeTimer: ReturnType<typeof setTimeout> | null = null;

    function typeOut() {
      if (!heading) return;
      if (typeTimer) clearTimeout(typeTimer);
      heading.textContent = '';
      let i = 0;
      const step = () => {
        heading.textContent = fullText.slice(0, i + 1);
        i++;
        if (i < fullText.length) {
          typeTimer = setTimeout(step, 55);
        }
      };
      step();
    }

    document.addEventListener('themechange', (e: Event) => {
      if (!heading) return;
      const detail = (e as CustomEvent).detail as { theme?: string } | undefined;
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (typeTimer) clearTimeout(typeTimer);

      if (detail?.theme === 'terminal' && !reduceMotion) {
        typeOut();
      } else {
        heading.innerHTML = fullHTML;
      }
    });

    // Page loaded directly into terminal mode (saved from a previous visit) —
    // still play the typing effect once the hero's own fade-in has settled.
    if (heading && document.documentElement.getAttribute('data-theme') === 'terminal') {
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!reduceMotion) {
        setTimeout(typeOut, 750);
      }
    }
  </script>

</Base>
