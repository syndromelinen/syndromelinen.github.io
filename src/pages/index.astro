---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { readingTimeMinutes } from '../utils/readingTime';
import { Image } from 'astro:assets';
import avatar from '../assets/avatar.jpg';

const cyber = await getCollection('cybersecurity', p => !p.data.draft);
const prog = await getCollection('programming', p => !p.data.draft);
const journal = await getCollection('journal', p => !p.data.draft);

const latestCyber = cyber.sort((a,b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()).slice(0,3);
const latestProg = prog.sort((a,b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()).slice(0,3);
const latestJournal = journal.sort((a,b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()).slice(0,3);

function fmt(d: string) {
  return new Date(d).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
}
---

<Base title="home">

  <!-- HERO -->
  <section class="hero">
    <div class="hero-glow"></div>
    <h1>kennytherex<span class="dot">.</span></h1>
    <div class="hero-stack">
      <span>Cybersecurity.</span> Programming. Thoughts.
    </div>
    <p class="hero-desc">
      Just a cybersec guy — mostly offensive security.
    </p>
    <div class="hero-btns">
      <a href="/journal" class="btn btn-primary">
        Read Journal <span class="btn-arrow">→</span>
      </a>
      <a href="/cybersecurity" class="btn btn-secondary">Browse Writeups</a>
    </div>

    <button class="scroll-cue" aria-label="Scroll to content" onclick="document.getElementById('about-preview').scrollIntoView({behavior:'smooth'})">
      <span class="scroll-cue-line"></span>
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <polyline points="6 9 12 15 18 9"/>
      </svg>
    </button>
  </section>

  <!-- ABOUT PREVIEW -->
  <section class="about-preview reveal-up" id="about-preview">
    <Image src={avatar} alt="Kenneth Solomon" width={64} height={64} loading="eager" class="about-preview-avatar" />
    <div class="about-preview-text">
      <p>
        I'm <strong>Kenneth</strong>, <strong>kennytherex</strong> online — I study cybersecurity,
        build things, and write about what I learn.
      </p>
      <a href="/about" class="view-all">More about me →</a>
    </div>
  </section>

  <hr class="divider" />

  <!-- LATEST JOURNAL -->
  <section class="section-block reveal-up">
    <div class="section-header">
      <span class="section-title">Latest Journal</span>
      <a href="/journal" class="view-all">View all →</a>
    </div>
    <div class="timeline">
      {latestJournal.map(post => (
        <a href={`/journal/${post.slug}`} class="timeline-item reveal-up">
          <div class="timeline-date">{fmt(post.data.date)}</div>
          <div class="timeline-title">{post.data.title}</div>
          <div class="timeline-desc">{post.data.description}</div>
        </a>
      ))}
    </div>
  </section>

  <!-- LATEST CYBERSECURITY -->
  <section class="section-block reveal-up">
    <div class="section-header">
      <span class="section-title">Latest Cybersecurity</span>
      <a href="/cybersecurity" class="view-all">View all →</a>
    </div>
    <div class="cards-grid">
      {latestCyber.map(post => (
        <a href={`/cybersecurity/${post.slug}`} class="blog-card reveal-up">
          <div class="card-meta">
            <span class="card-date">{fmt(post.data.date)}</span>
            <span class="card-dot">·</span>
            <span class="card-reading">{readingTimeMinutes(post.body)} min read</span>
          </div>
          <div class="card-title">{post.data.title}</div>
          <div class="card-desc">{post.data.description}</div>
          <div class="card-footer">
            <div class="card-tags">
              {post.data.tags.slice(0,3).map((t: string) => <span class="tag">{t}</span>)}
            </div>
            <span class="card-read">Read <span class="btn-arrow">→</span></span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- LATEST PROGRAMMING -->
  <section class="section-block reveal-up">
    <div class="section-header">
      <span class="section-title">Latest Programming</span>
      <a href="/programming" class="view-all">View all →</a>
    </div>
    <div class="cards-grid">
      {latestProg.map(post => (
        <a href={`/programming/${post.slug}`} class="blog-card reveal-up">
          <div class="card-meta">
            <span class="card-date">{fmt(post.data.date)}</span>
            <span class="card-dot">·</span>
            <span class="card-reading">{readingTimeMinutes(post.body)} min read</span>
          </div>
          <div class="card-title">{post.data.title}</div>
          <div class="card-desc">{post.data.description}</div>
          <div class="card-footer">
            <div class="card-tags">
              {post.data.tags.slice(0,3).map((t: string) => <span class="tag">{t}</span>)}
            </div>
            <span class="card-read">Read <span class="btn-arrow">→</span></span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <script>
    const heading = document.querySelector<HTMLElement>('.hero h1');
    const fullHTML = heading?.innerHTML ?? '';
    const fullText = heading?.textContent ?? '';
    let typeTimer: ReturnType<typeof setTimeout> | null = null;

    function typeOut() {
      if (!heading) return;
      if (typeTimer) clearTimeout(typeTimer);
      heading.textContent = '';
      let i = 0;
      const step = () => {
        heading.textContent = fullText.slice(0, i + 1);
        i++;
        if (i < fullText.length) {
          typeTimer = setTimeout(step, 55);
        }
      };
      step();
    }

    document.addEventListener('themechange', (e: Event) => {
      if (!heading) return;
      const detail = (e as CustomEvent).detail as { theme?: string } | undefined;
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (typeTimer) clearTimeout(typeTimer);

      if (detail?.theme === 'terminal' && !reduceMotion) {
        typeOut();
      } else {
        heading.innerHTML = fullHTML;
      }
    });

    // Page loaded directly into terminal mode (saved from a previous visit) —
    // still play the typing effect once the hero's own fade-in has settled.
    if (heading && document.documentElement.getAttribute('data-theme') === 'terminal') {
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!reduceMotion) {
        setTimeout(typeOut, 750);
      }
    }
  </script>

</Base>
