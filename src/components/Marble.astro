---
// Site-wide background: a dim starfield with a subtle digital-glitch feel.
//  - some stars carry a faint grey "ghost" split (black-and-white only, no colour)
//  - a few stars twitch a pixel or two, or blink out for a moment
//  - every ~6-15s a very short burst of shifted scan-bands + faint grey scan lines passes through
// Look/dimness is controlled in global.css (#marble canvas opacity).
// Set GLITCH_BURSTS = false below to keep the stars but drop the bursts.
---
<div id="marble" aria-hidden="true">
  <canvas id="starfield"></canvas>
</div>
<script>
  const GLITCH_BURSTS = true;

  const canvas = document.getElementById('starfield') as HTMLCanvasElement | null;
  const ctx = canvas?.getContext('2d');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (canvas && ctx) {
    type Star = {
      x: number; y: number; r: number; baseAlpha: number; phase: number; speed: number;
      driftX: number; driftY: number; isGlyph: boolean; char: string;
      fringe: boolean; twitch: boolean; offUntil: number;
    };
    let w = 0, h = 0;
    let stars: Star[] = [];
    let starRgb = '242, 242, 240';
    let isTerminal = document.documentElement.getAttribute('data-theme') === 'terminal';

    // glitch burst state
    let bands: { y: number; h: number; dx: number }[] = [];
    let glitchUntil = 0;
    let nextGlitch = 3000 + Math.random() * 4000;

    function readTheme() {
      starRgb = getComputedStyle(document.documentElement).getPropertyValue('--star-rgb').trim() || starRgb;
      isTerminal = document.documentElement.getAttribute('data-theme') === 'terminal';
    }
    readTheme();
    new MutationObserver(readTheme).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });

    function resize() {
      w = canvas!.width = window.innerWidth;
      h = canvas!.height = window.innerHeight;
      const count = Math.floor((w * h) / 6000);
      stars = Array.from({ length: count }, () => ({
        x: Math.random() * w,
        y: Math.random() * h,
        r: Math.random() * 1.1 + 0.2,
        baseAlpha: Math.random() * 0.5 + 0.15,
        phase: Math.random() * Math.PI * 2,
        speed: Math.random() * 0.4 + 0.08,
        driftX: (Math.random() - 0.5) * 0.02,
        driftY: (Math.random() - 0.5) * 0.02,
        isGlyph: Math.random() < 0.1,
        char: Math.random() < 0.5 ? '$' : '>',
        fringe: Math.random() < 0.22,
        twitch: Math.random() < 0.08,
        offUntil: 0,
      }));
    }

    function startGlitch(t: number) {
      const n = 2 + Math.floor(Math.random() * 3);
      bands = Array.from({ length: n }, () => ({
        y: Math.random() * h,
        h: 2 + Math.random() * Math.max(8, h * 0.035),
        dx: (Math.random() < 0.5 ? -1 : 1) * (4 + Math.random() * 14),
      }));
      glitchUntil = t + 90 + Math.random() * 140;
      nextGlitch = glitchUntil + 6000 + Math.random() * 9000;
    }

    function tick(t: number) {
      ctx!.clearRect(0, 0, w, h);
      for (const s of stars) {
        s.x += s.driftX;
        s.y += s.driftY;
        if (s.x < 0) s.x = w;
        if (s.x > w) s.x = 0;
        if (s.y < 0) s.y = h;
        if (s.y > h) s.y = 0;

        if (!reduceMotion) {
          // rare brief blink-out
          if (t > s.offUntil && Math.random() < 0.0004) s.offUntil = t + 60 + Math.random() * 120;
          if (t < s.offUntil) continue;
        }

        const a = Math.max(0, s.baseAlpha + Math.sin(t * 0.001 * s.speed + s.phase) * 0.2);
        // occasional 1-3px sideways twitch, this frame only
        const tx = !reduceMotion && s.twitch && Math.random() < 0.003 ? (Math.random() < 0.5 ? -1 : 1) * (1 + Math.random() * 2) : 0;
        const x = s.x + tx;

        if (isTerminal && s.isGlyph) {
          ctx!.fillStyle = `rgba(${starRgb},${a})`;
          const fontSize = 10 + s.r * 8;
          ctx!.font = `${fontSize}px "JetBrains Mono", monospace`;
          ctx!.textAlign = 'center';
          ctx!.textBaseline = 'middle';
          ctx!.fillText(s.char, x, s.y);
          continue;
        }

        if (s.fringe) {
          // faint monochrome ghost: dimmer duplicates just left and right of the star
          ctx!.fillStyle = `rgba(${starRgb}, ${a * 0.35})`;
          ctx!.beginPath();
          ctx!.arc(x - 1.3, s.y, s.r, 0, Math.PI * 2);
          ctx!.fill();
          ctx!.beginPath();
          ctx!.arc(x + 1.3, s.y, s.r, 0, Math.PI * 2);
          ctx!.fill();
        }
        ctx!.fillStyle = `rgba(${starRgb},${a})`;
        ctx!.beginPath();
        ctx!.arc(x, s.y, s.r, 0, Math.PI * 2);
        ctx!.fill();
      }

      if (GLITCH_BURSTS && !reduceMotion) {
        if (t >= nextGlitch && t >= glitchUntil) startGlitch(t);
        if (t < glitchUntil) {
          for (const b of bands) {
            // shift a horizontal slice sideways
            ctx!.drawImage(canvas!, 0, b.y, w, b.h, b.dx, b.y, w, b.h);
            // thin dim grey scan streaks (black & white only)
            const sx = Math.random() * w * 0.6;
            ctx!.fillStyle = `rgba(${starRgb}, 0.22)`;
            ctx!.fillRect(sx, b.y, 40 + Math.random() * w * 0.3, 2);
            ctx!.fillStyle = `rgba(${starRgb}, 0.12)`;
            ctx!.fillRect(sx + b.dx, b.y + Math.min(b.h - 1, 3), 30 + Math.random() * w * 0.25, 2);
          }
        }
      }

      if (!reduceMotion) requestAnimationFrame(tick);
    }

    window.addEventListener('resize', resize);
    resize();
    if (reduceMotion) {
      tick(0);
    } else {
      requestAnimationFrame(tick);
    }
  }
</script>
