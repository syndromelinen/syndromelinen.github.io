<div id="marble">
  <div id="marble-img"></div>
</div>
<script>
  const wrap = document.getElementById('marble');
  const img = document.getElementById('marble-img');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // mouse parallax — smoothed toward target so it never snaps
  let mx = 0, my = 0, tmx = 0, tmy = 0;

  window.addEventListener('pointermove', (e) => {
    tmx = (e.clientX / window.innerWidth - 0.5) * 2;
    tmy = (e.clientY / window.innerHeight - 0.5) * 2;
  }, { passive: true });

  function tick() {
    // soft catch-up, never snaps to the cursor
    mx += (tmx - mx) * 0.015;
    my += (tmy - my) * 0.015;

    if (wrap) {
      wrap.style.transform = `translate3d(${mx * 16}px, ${my * 12}px, 0)`;
    }

    if (!reduceMotion) requestAnimationFrame(tick);
  }

  if (!reduceMotion) {
    requestAnimationFrame(tick);
  }
</script>
