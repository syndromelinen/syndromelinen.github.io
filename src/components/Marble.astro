---
---
<canvas id="marble"></canvas>

<script>
  const canvas = document.getElementById('marble');
  const ctx = canvas.getContext('2d');
  let t = 0;

  function resize() {
    canvas.width = window.innerWidth;
    canvas.height = window.innerHeight;
  }

  resize();
  window.addEventListener('resize', resize);

  function draw() {
    const w = canvas.width, h = canvas.height;
    ctx.clearRect(0, 0, w, h);

    // base void
    ctx.fillStyle = '#050507';
    ctx.fillRect(0, 0, w, h);

    // ambient purple pools
    const pools = [
      { xr: 0.15, yr: 0.25, rr: 0.45, a: 0.07, phase: 0 },
      { xr: 0.75, yr: 0.55, rr: 0.38, a: 0.055, phase: 1.4 },
      { xr: 0.45, yr: 0.80, rr: 0.32, a: 0.05, phase: 2.8 },
      { xr: 0.85, yr: 0.15, rr: 0.28, a: 0.04, phase: 4.2 },
    ];

    pools.forEach((p, i) => {
      const x = w * (p.xr + Math.sin(t * 0.00025 + p.phase) * 0.06);
      const y = h * (p.yr + Math.cos(t * 0.0002 + p.phase) * 0.05);
      const r = Math.min(w, h) * p.rr;
      const g = ctx.createRadialGradient(x, y, 0, x, y, r);
      g.addColorStop(0, `rgba(123,47,190,${p.a})`);
      g.addColorStop(0.5, `rgba(80,20,140,${p.a * 0.35})`);
      g.addColorStop(1, 'rgba(0,0,0,0)');
      ctx.fillStyle = g;
      ctx.fillRect(0, 0, w, h);
    });

    // marble veins
    for (let v = 0; v < 4; v++) {
      ctx.beginPath();
      const startX = w * (0.05 + v * 0.28 + Math.sin(t * 0.0001 + v) * 0.08);
      ctx.moveTo(startX, 0);
      for (let y = 0; y <= h; y += 3) {
        const x = startX
          + Math.sin(y * 0.007 + t * 0.0003 + v * 1.8) * 55
          + Math.sin(y * 0.018 + t * 0.00015 + v) * 22
          + Math.cos(y * 0.003 + v * 0.7) * 18;
        ctx.lineTo(x, y);
      }
      const alpha = 0.035 + v * 0.015;
      ctx.strokeStyle = `rgba(168,85,247,${alpha})`;
      ctx.lineWidth = 1 + v * 0.3;
      ctx.stroke();
    }

    // thin bright accent vein
    ctx.beginPath();
    const ax = w * (0.6 + Math.sin(t * 0.0002) * 0.12);
    ctx.moveTo(ax, 0);
    for (let y = 0; y <= h; y += 2) {
      const x = ax + Math.sin(y * 0.011 + t * 0.0004) * 30 + Math.cos(y * 0.005) * 15;
      ctx.lineTo(x, y);
    }
    ctx.strokeStyle = 'rgba(192,132,252,0.06)';
    ctx.lineWidth = 0.8;
    ctx.stroke();

    t++;
    requestAnimationFrame(draw);
  }

  draw();
</script>
